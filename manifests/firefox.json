{
  "manifest_version": 3,
  "name": "X Region Reveal & Block",
  "version": "0.0.1",
  "description": "Development foundation for a future X region reveal and block extension; user-facing features are not implemented yet.",
  "permissions": ["storage"],
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content/content-script.js"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
