{
  "manifest_version": 3,
  "name": "X Region Reveal & Block",
  "version": "0.0.1",
  "description": "Development integration for account-region badges and configured actions on supported X and Twitter documents.",
  "permissions": ["storage"],
  "background": {
    "scripts": ["background/service-worker.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*"
      ],
      "js": ["content/content-script.js"],
      "css": ["content/account-actions.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["page/page-script.js", "assets/flags/*.png"],
      "matches": ["https://x.com/*", "https://twitter.com/*"]
    }
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  }
}
